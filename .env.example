# Application Settings
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="Hirekit Backend"

# Security
JWT_SECRET_KEY=dev-secret-key-hirekit-please-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# Database (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://hirekit:hirekit@localhost:5432/hirekit

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 / Cloudflare R2 Storage
S3_BUCKET=hirekit-uploads
AWS_ACCESS_KEY_ID=mock_key
AWS_SECRET_ACCESS_KEY=mock_secret
AWS_REGION=ap-south-1
CDN_BASE=https://cdn.hirekit.com

# AI Services
GEMINI_API_KEY=

# Email Services
SENDGRID_API_KEY=
FROM_EMAIL=noreply@hirekit.com

# Observability
SENTRY_DSN=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
